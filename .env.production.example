# =====================================================================
# .env de PRODUCCION - Sistema Web Vida Salud en AWS EC2 (Docker)
# Copiar en el servidor:  cp .env.production.example .env  y completar los valores <...>
# Luego:  docker compose exec app php artisan key:generate   (solo la primera vez)
#         docker compose exec app php artisan optimize
# =====================================================================
APP_NAME="Clinica Vida Salud"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Con HTTPS activado (docker/https/activar-https.sh) use el dominio https; sin HTTPS: http://18.218.0.2:8000
APP_URL=https://18-218-0-2.sslip.io
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL 16 en el contenedor "postgres" (puerto 5432 publicado para pgAdmin 4)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bd_vida_salud
DB_USERNAME=postgres
DB_PASSWORD=<misma contrasena que POSTGRES_PASSWORD en docker-compose.yml>

# Sesiones en base de datos. SESSION_SECURE_COOKIE=false permite entrar tambien por http://IP:8000
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo de recordatorios (CU31) con Gmail: usar una "contrasena de aplicacion" de Google
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<sucorreo@gmail.com>
MAIL_PASSWORD=<contrasena de aplicacion de 16 letras>
MAIL_FROM_ADDRESS=<sucorreo@gmail.com>
MAIL_FROM_NAME="Clinica Vida Salud"
